{
  "name": "wordpress/dev",
  "description": "wordpress development setup",
  "license": "MIT",
  "type": "project",
  "repositories": [
    {
      "type": "composer",
      "url": "https://connect.advancedcustomfields.com"
    },
    {
      "type": "composer",
      "url": "https://wpackagist.org"
    }
  ],
  "require": {
    "php": "^8.4",
    "composer/installers": "^2.2",
    "wpackagist-plugin/duplicate-post": "^4.5",
    "wpackagist-plugin/query-monitor": "^3.17",
    "wpackagist-plugin/wordpress-seo": "^25.2",
    "wpackagist-theme/twentytwentyfive": "^1.2"
  },
  "require-dev": {
    "automattic/vipwpcs": "^3.0"
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "composer/installers": true,
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "extra": {
    "installer-paths": {
      "wp-content/mu-plugins/{$name}/": [
        "type:wordpress-muplugin"
      ],
      "wp-content/plugins/{$name}/": [
        "type:wordpress-plugin"
      ],
      "wp-content/themes/{$name}/": [
        "type:wordpress-theme"
      ]
    }
  },
  "scripts": {
    "test": "bash ./scripts/test.sh",
    "setup": "bash ./scripts/setup.sh",
    "build": "bash ./scripts/build.sh",
    "format": "composer run format:plugins && composer run format:theme",
    "format-fix": "composer run format-fix:plugins && composer run format-fix:theme",
    "format:plugins": "vendor/bin/phpcs ./wp-content/mu-plugins --standard=phpcs.xml -sp",
    "format:theme": "vendor/bin/phpcs ./wp-content/themes/habitstracker --standard=phpcs.xml",
    "format-fix:plugins": "vendor/bin/phpcbf ./wp-content/mu-plugins --standard=phpcs.xml",
    "format-fix:theme": "vendor/bin/phpcbf ./wp-content/themes/habitstracker --standard=phpcs.xml"
  }
}
